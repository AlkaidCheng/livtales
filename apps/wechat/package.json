{
  "name": "@livtales/wechat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:weapp && pnpm bundle:check",
    "build:weapp": "taro build --type weapp",
    "bundle:check": "node --import tsx scripts/report-bundle.ts",
    "bundle:report": "node --import tsx scripts/report-bundle.ts --json",
    "release:preflight": "node --import tsx scripts/release-preflight.ts",
    "dev:weapp": "taro build --type weapp --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@livtales/api-client": "workspace:*",
    "@livtales/schemas": "workspace:*",
    "@cloudbase/js-sdk": "3.10.0",
    "@tanstack/react-query": "5.103.1",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@tarojs/cli": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "18.3.31",
    "@types/webpack-env": "1.18.8",
    "babel-preset-taro": "4.3.0",
    "postcss": "8.5.28",
    "react-refresh": "0.14.2",
    "sass": "1.105.1",
    "typescript": "5.9.3",
    "webpack": "5.91.0"
  }
}
