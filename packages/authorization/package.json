{
  "name": "@livtales/authorization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @livtales/db build && tsc -p tsconfig.build.json",
    "test": "pnpm --filter @livtales/db build && vitest run",
    "test:unit": "vitest run",
    "typecheck": "pnpm --filter @livtales/db build && tsc -p tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livtales/db": "workspace:*",
    "drizzle-orm": "0.45.3"
  }
}
