{
  "name": "@livtales/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @livtales/schemas build && tsc -p tsconfig.build.json",
    "test": "pnpm --filter @livtales/schemas build && vitest run",
    "test:unit": "vitest run",
    "typecheck": "pnpm --filter @livtales/schemas build && tsc -p tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livtales/schemas": "workspace:*",
    "zod": "4.6.7"
  }
}
