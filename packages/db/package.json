{
  "name": "@livtales/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/testing.*",
    "!dist/cloudbase-testing.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/cli.ts",
    "footprint": "tsx src/footprint-cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.11.0",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.0",
    "uuid": "14.0.3",
    "ws": "8.22.2",
    "zod": "4.6.7"
  }
}
